
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111111">
<title>Our Menu | KAGINOLO Catering</title>
<meta name="description" content="Explore the KAGINOLO catering platter collection. Beautifully prepared food for sharing.">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root{
  --black:#101010;
  --dark:#171717;
  --panel:#1d1d1d;
  --gold:#c6a66f;
  --gold-light:#e0c99d;
  --cream:#f3eee5;
  --muted:#aaa49a;
  --line:rgba(198,166,111,.22);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--black);
  color:var(--cream);
  font-family:'DM Sans',Arial,sans-serif;
  line-height:1.7;
}
a{color:inherit;text-decoration:none}
button{font:inherit}
header{
  min-height:88px;
  padding:18px 7%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  background:#090909;
  border-bottom:1px solid var(--line);
}
.logo{
  font-family:'Playfair Display',Georgia,serif;
  font-size:25px;
  letter-spacing:5px;
}
.logo span{
  display:block;
  text-align:center;
  color:var(--gold);
  font:9px 'DM Sans',Arial,sans-serif;
  letter-spacing:5px;
  margin-top:3px;
}
.back-link{
  color:var(--gold-light);
  font-size:10px;
  letter-spacing:2px;
  border-bottom:1px solid var(--line);
  padding-bottom:5px;
}
.hero{
  padding:85px 7% 75px;
  text-align:center;
  background:
    radial-gradient(ellipse at top,rgba(198,166,111,.12),transparent 65%),
    #111;
  border-bottom:1px solid var(--line);
}
.eyebrow{
  color:var(--gold);
  font-size:10px;
  letter-spacing:4px;
}
h1,h2,h3{
  font-family:'Playfair Display',Georgia,serif;
  font-weight:normal;
}
.hero h1{
  font-size:clamp(42px,7vw,68px);
  line-height:1.15;
  margin:20px 0;
}
.hero p{
  max-width:570px;
  margin:0 auto;
  color:var(--muted);
  font-size:13px;
  line-height:2;
}
main{
  max-width:1250px;
  margin:auto;
  padding:65px 6% 90px;
}
.collection-heading{
  text-align:center;
  margin-bottom:42px;
}
.collection-heading h2{
  font-size:34px;
  margin:12px 0;
}
.collection-heading p{
  color:var(--muted);
  font-size:12px;
}
.menu-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:25px;
}
.menu-card{
  background:var(--panel);
  border:1px solid var(--line);
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:transform .25s,border-color .25s;
}
.menu-card:hover{
  transform:translateY(-4px);
  border-color:var(--gold);
}
.menu-image{
  height:245px;
  background:#24221e;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  color:var(--gold);
  font-family:'Playfair Display',Georgia,serif;
  letter-spacing:3px;
  font-size:15px;
}
.menu-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
.menu-content{
  padding:25px;
  display:flex;
  flex:1;
  flex-direction:column;
}
.menu-category{
  color:var(--gold);
  font-size:9px;
  letter-spacing:3px;
  text-transform:uppercase;
}
.menu-content h3{
  font-size:25px;
  line-height:1.3;
  margin:12px 0;
}
.description{
  color:var(--muted);
  font-size:12px;
  line-height:1.9;
  margin:0 0 15px;
}
.serves{
  color:#c9c0b2;
  font-size:10px;
  letter-spacing:1px;
  margin-top:auto;
  padding-top:10px;
}
.price{
  color:var(--gold-light);
  font-family:'Playfair Display',Georgia,serif;
  font-size:28px;
  margin:12px 0 18px;
}
.enquire{
  display:inline-block;
  text-align:center;
  padding:14px 18px;
  background:var(--gold);
  color:#171717;
  font-size:10px;
  font-weight:700;
  letter-spacing:1.5px;
  transition:.2s;
}
.enquire:hover{
  background:transparent;
  color:var(--gold-light);
  outline:1px solid var(--gold);
}
.message{
  grid-column:1/-1;
  text-align:center;
  padding:35px 20px;
  color:var(--muted);
  border:1px dashed var(--line);
  font-size:13px;
}
.note{
  margin:55px auto 0;
  max-width:700px;
  padding:25px;
  text-align:center;
  border:1px solid var(--line);
  color:var(--muted);
  font-size:12px;
  line-height:2;
}
.note strong{color:var(--gold-light)}
footer{
  padding:45px 20px 30px;
  background:#090909;
  border-top:1px solid var(--line);
  text-align:center;
}
.footer-name{
  font-family:'Playfair Display',Georgia,serif;
  font-size:25px;
  letter-spacing:5px;
}
.footer-sub{
  color:var(--gold);
  font-size:9px;
  letter-spacing:5px;
  margin:5px 0 18px;
}
.footer-copy{
  color:#77736c;
  font-size:9px;
  letter-spacing:1px;
  margin-top:20px;
}
@media(max-width:650px){
  header{padding:18px 5%}
  .logo{font-size:21px}
  .hero{padding:70px 7%}
  main{padding:50px 5% 70px}
  .menu-grid{grid-template-columns:1fr}
  .menu-image{height:250px}
}
</style>
</head>

<body>
<header>
  <a class="logo" href="index.html">
    KAGINOLO
    <span>CATERING SOLUTION</span>
  </a>
  <a class="back-link" href="index.html">← BACK TO HOME</a>
</header>

<section class="hero">
  <div class="eyebrow">PREPARED WITH CARE · MADE FOR SHARING</div>
  <h1>Our Menu.</h1>
  <p>
    Discover the KAGINOLO collection of sharing platters.
    Thoughtfully prepared for family gatherings, celebrations
    and occasions worth bringing people together.
  </p>
</section>

<main>
  <div class="collection-heading">
    <div class="eyebrow">THE COLLECTION</div>
    <h2>Explore our platters.</h2>
    <p>Our published selections and current pricing are displayed below.</p>
  </div>

  <div class="menu-grid" id="menu-grid">
    <div class="message">Preparing the KAGINOLO collection...</div>
  </div>

  <div class="note">
    <strong>PLEASE NOTE</strong><br>
    All orders are subject to confirmation and availability.
    Please enquire in advance so that we can discuss your preferred date
    and arrangements.
  </div>
</main>

<footer>
  <div class="footer-name">KAGINOLO</div>
  <div class="footer-sub">CATERING SOLUTION</div>
  <div class="footer-copy">
    PRETORIA · SOSHANGUVE · MIDRAND
    <br>
    GOOD FOOD. BEAUTIFULLY SERVED.
    <br><br>
    © 2026 KAGINOLO CATERING. ALL RIGHTS RESERVED.
  </div>
</footer>

<script>
const SUPABASE_URL =
  "https://psmsmscsfcaetyayqkty.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  "sb_publishable_nc6RlN8ZAEzEnGbw_u-oXg_J8Www63k";

const supabaseClient = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_PUBLISHABLE_KEY
);

async function loadMenu(){
  const grid = document.getElementById("menu-grid");

  const {data,error} = await supabaseClient
    .from("menu_items")
    .select("id,name,description,category,price,serves,image_url")
    .eq("is_published",true)
    .order("created_at",{ascending:false});

  if(error){
    console.error("Menu loading error:",error);
    grid.innerHTML =
      '<div class="message">Our menu is temporarily unavailable. Please try again shortly.</div>';
    return;
  }

  if(!data || data.length === 0){
    grid.innerHTML =
      '<div class="message">Our collection is being updated. Please check back soon.</div>';
    return;
  }

  grid.replaceChildren();

  data.forEach(item => {
    const card = document.createElement("article");
    card.className = "menu-card";

    const imageBox = document.createElement("div");
    imageBox.className = "menu-image";

    if(item.image_url){
      const image = document.createElement("img");
      image.src = item.image_url;
      image.alt = item.name || "KAGINOLO platter";
      image.loading = "lazy";

      image.onerror = () => {
        imageBox.replaceChildren();
        imageBox.textContent = "KAGINOLO";
      };

      imageBox.appendChild(image);
    }else{
      imageBox.textContent = "KAGINOLO";
    }

    const content = document.createElement("div");
    content.className = "menu-content";

    const category = document.createElement("div");
    category.className = "menu-category";
    category.textContent = item.category || "KAGINOLO COLLECTION";

    const name = document.createElement("h3");
    name.textContent = item.name || "KAGINOLO Platter";

    const description = document.createElement("p");
    description.className = "description";
    description.textContent =
      item.description || "Prepared with care and made for sharing.";

    const serves = document.createElement("div");
    serves.className = "serves";
    serves.textContent = item.serves
      ? "SERVES " + item.serves
      : "SERVING DETAILS AVAILABLE ON ENQUIRY";

    const price = document.createElement("div");
    price.className = "price";
    price.textContent =
      item.price !== null && item.price !== undefined
        ? "R" + Number(item.price).toFixed(2)
        : "Price on enquiry";

    const enquire = document.createElement("a");
    enquire.className = "enquire";
    enquire.textContent = "ENQUIRE ABOUT THIS PLATTER";
    enquire.href =
      "index.html?platter=" +
      encodeURIComponent(item.name || "KAGINOLO platter") +
      "#contact";

    content.append(
      category,
      name,
      description,
      serves,
      price,
      enquire
    );

    card.append(imageBox,content);
    grid.appendChild(card);
  });
}

loadMenu();
</script>
</body>
</html>
